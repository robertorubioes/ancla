APP_NAME=Firmalum
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# Dominio base del que cuelgan los subdominios de tenant. Ver docs/ENTORNOS.md
#   local       firmalum.test        (la app en app.firmalum.test)
#   testing     test.firmalum.com    (la app en app.test.firmalum.com)
#   produccion  firmalum.com         (la app en app.firmalum.com)
APP_BASE_DOMAIN=firmalum.com

# Encryption Configuration (E2-003)
# Generate master key: openssl rand -base64 32
APP_ENCRYPTION_KEY=
ENCRYPTION_KEY_VERSION=v1
ENCRYPTION_KEY_CACHE_TTL=3600
ENCRYPTION_ALGORITHM=aes-256-gcm
ENCRYPTION_DEBUG_LOGGING=false
ENCRYPTION_BATCH_CHUNK_SIZE=100
ENCRYPTION_BATCH_DELAY=100000
ENCRYPTION_REQUIRE_HTTPS=true
ENCRYPTION_MIN_SIZE=1
ENCRYPTION_MAX_SIZE=104857600

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Niveles de archivo a largo plazo. Si se dejan vacios, se usan AWS_BUCKET y
# AWS_DEFAULT_REGION. Los discos s3-glacier y s3-deep-archive se declaran en
# config/filesystems.php y los referencia config/archive.php.
ARCHIVE_COLD_STORAGE_BUCKET=
ARCHIVE_COLD_STORAGE_REGION=
ARCHIVE_DEEP_STORAGE_BUCKET=
ARCHIVE_DEEP_STORAGE_REGION=

# Amazon SES para correo. Solo si el disco s3 apunta a otro proveedor con
# claves distintas; si se dejan vacias se usan las AWS_ de arriba.
AWS_SES_KEY=
AWS_SES_SECRET=
AWS_SES_REGION=

# TSA (Time Stamping Authority) Configuration
# For eIDAS compliant timestamps
TSA_PRIMARY_PROVIDER=firmaprofesional
TSA_FALLBACK_PROVIDER=digicert
TSA_MOCK_ENABLED=true
TSA_TIMEOUT=30
TSA_RETRY_ATTEMPTS=3
# TSA_FIRMAPROFESIONAL_URL=https://tsa.firmaprofesional.com/tsa
# TSA_DIGICERT_URL=https://timestamp.digicert.com

# Audit Trail Configuration
AUDIT_RETENTION_DAYS=1825

# Evidence Packages
EVIDENCE_STORAGE_DISK=local
# EVIDENCE_PACKAGE_EXPIRY_DAYS=null

# Backup Configuration (E2-003)
BACKUP_ENCRYPTION_ENABLED=true
BACKUP_SCHEDULE="0 2 * * *"
BACKUP_RETENTION_DAYS=30
BACKUP_LOCAL_DIR=storage/backups
# Clave con la que se cifra el .env dentro del backup. Exclusiva de este
# proyecto: nunca reutilizar la de otro. Sin ella, scripts/backup.sh aborta.
BACKUP_ENCRYPTION_KEY=
BACKUP_DISK=s3
BACKUP_PATH=backups/encrypted

VITE_APP_NAME="${APP_NAME}"

#------------------------------------------------------------------------------
# Superadministrador (usado solo por SuperadminSeeder)
#------------------------------------------------------------------------------
# En produccion y staging SUPERADMIN_PASSWORD es obligatorio; sin el, el
# seeder aborta. En local, si se deja vacio, se genera una aleatoria.
SUPERADMIN_EMAIL=
SUPERADMIN_NAME=Superadmin
SUPERADMIN_PASSWORD=

#------------------------------------------------------------------------------
# Clon nocturno de produccion a testing (solo en el servidor de testing)
#------------------------------------------------------------------------------
# Ver docs/ENTORNOS.md y scripts/clone-prod-to-test.sh
CLONE_SOURCE_ENV_FILE=/var/www/firmalum/.env.production
# Correos que NO se anonimizan, separados por coma. Normalmente el del
# operador, para poder entrar a mirar.
CLONE_PRESERVE_EMAILS=
# La BD destino debe casar con esto. Guarda contra clonar sobre produccion.
CLONE_TARGET_PATTERN=test
